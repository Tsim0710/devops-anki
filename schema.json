{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevOps Anki card",
  "type": "object",
  "required": ["id", "domain", "subtopic", "difficulty", "source", "prompt", "answer", "explanation"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$",
      "description": "Вечный непрозрачный ключ. Формат при создании <domain>-<subtopic>-NNN, после — просто строка."
    },
    "domain": {
      "type": "string",
      "enum": ["k8s", "networks", "linux", "docker", "cicd", "terraform", "ansible",
               "gcp", "cloudflare", "git", "observability", "security"]
    },
    "subtopic": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "difficulty": { "type": "string", "enum": ["junior", "middle", "senior"] },
    "source": {
      "oneOf": [
        { "type": "string", "enum": ["theory", "interview", "web"] },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["theory", "interview", "web"] }
        }
      ]
    },
    "type": { "type": "string", "enum": ["basic", "mcq"], "default": "basic" },
    "situational": { "type": "boolean", "default": false },
    "verified": { "type": "boolean", "default": false },
    "deprecated": { "type": "boolean", "default": false },
    "prompt": { "type": "string", "minLength": 8 },
    "options": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 5,
      "additionalProperties": false,
      "properties": {
        "a": { "type": "string", "minLength": 1 },
        "b": { "type": "string", "minLength": 1 },
        "c": { "type": "string", "minLength": 1 },
        "d": { "type": "string", "minLength": 1 },
        "e": { "type": "string", "minLength": 1 }
      }
    },
    "answer": { "type": "string", "minLength": 1 },
    "explanation": { "type": "string", "minLength": 10 },
    "ref": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "mcq" } }, "required": ["type"] },
      "then": {
        "required": ["options"],
        "properties": { "answer": { "pattern": "^[a-e]$" } }
      },
      "else": { "not": { "required": ["options"] } }
    },
    {
      "if": { "properties": { "situational": { "const": true } }, "required": ["situational"] },
      "then": {
        "properties": { "type": { "const": "basic" } }
      }
    }
  ]
}
